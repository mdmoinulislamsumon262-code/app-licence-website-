# Copy these values into Render Environment Variables.
# Never commit real credentials to this file or to application code.
DATABASE_URL=postgresql://user:password@host:5432/deviceguard
SESSION_SECRET=replace-with-a-long-random-value
DEVICEGUARD_ADMIN_USERNAME=choose-your-admin-id
DEVICEGUARD_ADMIN_PASSWORD=choose-a-strong-admin-password
# Optional: comma-separated browser origins if the API is hosted separately.
# CORS_ORIGIN=https://your-dashboard.example.com